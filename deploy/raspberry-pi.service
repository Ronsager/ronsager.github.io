# VORLAGE mit Beispielpfaden (Benutzer "pi", Projekt in /home/pi).
#
# Diese Datei nur verwenden, wenn du die Pfade von Hand anpassen willst.
# Empfohlen ist stattdessen:
#
#   sudo ./deploy/install-service.sh
#
# Das Skript liest Benutzername, Projektpfad und Node-Pfad vom laufenden
# System aus und erzeugt die Dienst-Datei daraus – dadurch entfallen genau
# die festen Pfade, die hier stehen.
#
# Installation:
#   sudo cp ~/star-trek-conquest/deploy/raspberry-pi.service \
#           /etc/systemd/system/star-trek-conquest.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now star-trek-conquest
#
# Heißt dein Benutzer nicht "pi", passe User, Group und die Pfade unten an.

[Unit]
Description=Star Trek Conquest – Browserspiel-Server
Documentation=file:///home/pi/star-trek-conquest/ANLEITUNG.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/star-trek-conquest
EnvironmentFile=/home/pi/star-trek-conquest/.env
ExecStart=/usr/local/bin/node server/index.js

# Nach Absturz oder Stromausfall automatisch neu starten
Restart=always
RestartSec=10

# Auf dem Zero 2 W darf der Start etwas länger dauern
TimeoutStartSec=90

# Absicherung
# ProtectSystem=full schützt /usr, /boot und /etc vor Schreibzugriffen und
# lässt /home beschreibbar. Die schärfere Stufe "strict" wurde bewusst nicht
# gewählt: Sie verlangt eine ReadWritePaths-Liste, und ein dort genannter,
# noch nicht existierender Pfad (data/ entsteht erst beim ersten Start) lässt
# systemd den Dienst mit "unavailable resources" abbrechen. Ausgelagerte
# Datenbanken auf USB-Sticks funktionieren so ebenfalls ohne Zusatzeintrag.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=star-trek-conquest

[Install]
WantedBy=multi-user.target
