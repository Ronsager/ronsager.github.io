# ─── Server ───────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Auf 1 setzen, wenn hinter einem Reverse-Proxy (nginx, Caddy, Traefik)
TRUST_PROXY=0

# ─── Sicherheit ───────────────────────────────────────────────────────
# UNBEDINGT ÄNDERN! z. B. mit:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=bitte-hier-einen-langen-zufallswert-eintragen
JWT_EXPIRES=7d

# ─── Datenbank ────────────────────────────────────────────────────────
DB_FILE=./data/universe.db

# ─── Erster Administrator (wird beim Start automatisch angelegt) ──────
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ─── Spielgeschwindigkeit (1 = OGame-Original, höher = schneller) ─────
SPEED_ECONOMY=5
SPEED_BUILD=5
SPEED_FLEET=3

# ─── Universum ────────────────────────────────────────────────────────
UNI_QUADRANTS=4
UNI_SYSTEMS=200
UNI_SLOTS=15

# ─── Startausstattung ─────────────────────────────────────────────────
START_DURANIUM=2000
START_DILITHIUM=1000
START_DEUTERIUM=500

# ─── Sonstiges ────────────────────────────────────────────────────────
TICK_INTERVAL_MS=5000
REGISTRATION_OPEN=true
